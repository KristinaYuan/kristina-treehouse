---
// index.astro — Homepage: title, intro, activity, explore, currently.
import BaseLayout from '../layouts/BaseLayout.astro';
import AboutSection from '../components/AboutSection.astro';
import EducationSection from '../components/EducationSection.astro';
import RecentActivity from '../components/RecentActivity.astro';
import SectionGrid from '../components/SectionGrid.astro';
import FriendLinks from '../components/FriendLinks.astro';
import CurrentlySection from '../components/CurrentlySection.astro';
---

<BaseLayout>
  <!-- Hero -->
  <section class="hero">
    <h1 class="hero__title">Kristina's Treehouse</h1>
    <p class="hero__subtitle">"I wish we could go there."</p>
  </section>

  <!-- Introduction -->
  <section class="intro">
    <p>
      Welcome to my treehouse. This is a place where I put away my thoughts, ideas, and memories in preparation for becoming a cyborg. (Bazinga!) You may consider it a pensieve you can visit using a simple spell, "<i>it's Kristina's space</i>".
    </p>
    <p>
      I took the idea of naming this blog from <i>The Magic Tree House</i> series which I loved as a kid. The tree house was designed to contain a cluster of books about many faraway places, both space and time. The key to entering a world in the book is to point at it and say "<i>I wish we could go there</i>". Hope it brings you into my world as well.
    </p>
    <p>
      Now, hurry up before you grow too big to fit into the rabbit hole!
    </p>
  </section>

  <!-- About -->
  <AboutSection />

  <!-- Education -->
  <EducationSection />

  <!-- Recent Activity -->
  <RecentActivity />

  <!-- Explore Sections -->
  <SectionGrid />

  <!-- Friend Links -->
  <FriendLinks />

  <!-- Currently -->
  <CurrentlySection />
</BaseLayout>

<style>
  .hero {
    margin-bottom: var(--space-lg);
  }

  .hero__title {
    font-family: var(--font-serif);
    font-size: var(--text-3xl);
    font-weight: 500;
    color: var(--color-text-primary);
    margin-bottom: var(--space-xs);
    line-height: var(--leading-tight);
  }

  .hero__subtitle {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-style: italic;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .intro {
    margin-bottom: var(--space-xl);
  }

  .intro p {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
  }
</style>
